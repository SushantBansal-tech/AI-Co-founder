# Hermes Agent - from agent/conversation_loop.py (simplified)
while api_call_count < max_iterations and iteration_budget.remaining > 0:
    # === "STATE" is implicit in the loop variables ===
    
    # 1. Check interrupt
    if agent._interrupt_requested:
        break
    
    # 2. Build message context
    messages = build_context()
    
    # 3. Call LLM (this is the "call_model" node equivalent)
    response = agent.client.chat.completions.create(
        model=agent.model,
        messages=messages,
        tools=tool_schemas,
    )
    api_call_count += 1
    
    # 4. Routing logic (replaces edges)
    if response.tool_calls:
        # === INLINE TOOL EXECUTION (no separate node) ===
        for tool_call in response.tool_calls:
            result = handle_function_call(
                tool_call.name,
                tool_call.arguments,
                task_id
            )
            # Add result to message history
            messages.append({
                "role": "tool",
                "content": result
            })
        
        # Loop back to step 1 (implicit edge back to "call_model")
        continue
    
    elif response.finish_reason == "stop":
        # === NO MORE TOOL CALLS → END STATE ===
        final_response = response.content
        return {
            "final_response": final_response,
            "messages": messages,
            "completed": True
        }
    
    else:
        # === HANDLE ERRORS/RETRIES ===
        if should_retry(response):
            retry_count += 1
            continue
        
        
    
    
    