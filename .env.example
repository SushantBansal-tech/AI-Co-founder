# DATABASE_URL=postgresql+asyncpg://sales_user:<password>@127.0.0.1:5433/sales_os
# LANGGRAPH_DATABASE_URL=postgresql://sales_user:<password>@127.0.0.1:5433/sales_os?sslmode=disable

# GEMINI_API_KEY=

# # Durable inbound channel workers
# CHANNEL_WORKER_ENABLED=true
# EMAIL_POLLER_ENABLED=false
# EMAIL_POLL_INTERVAL_SECONDS=30
# IDEMPOTENCY_STALE_SECONDS=900
# CHANNEL_CONFIGURATION_STRICT=true

# # Durable quotation follow-up worker
# FOLLOWUP_WORKER_ENABLED=true
# FOLLOWUP_WORKER_IDLE_SECONDS=5
# FOLLOWUP_STALE_SECONDS=300
# FOLLOWUP_RECONCILE_SECONDS=600
# FOLLOWUP_MAX_ATTEMPTS=5

# # Durable PostgreSQL -> Qdrant customer-memory projector
# MEMORY_WORKER_ENABLED=true
# MEMORY_WORKER_IDLE_SECONDS=2
# MEMORY_OUTBOX_STALE_SECONDS=300
# MEMORY_OUTBOX_MAX_ATTEMPTS=5

# # IMAP/SMTP credentials referenced by create_email_source.py
# SALES_EMAIL_USERNAME=
# SALES_EMAIL_PASSWORD=

# # Meta WhatsApp Cloud API credentials
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_ACCESS_TOKEN=
